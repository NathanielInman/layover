// The Layover lamp for waybar, from the README. Merge it into your
// ~/.config/waybar/config.jsonc and add "custom/layover" to a modules list.
"custom/layover": {
  "exec": "~/.local/bin/layover bar",
  "return-type": "json",
  "on-click": "~/.local/bin/layover toggle",
  "on-click-middle": "~/.local/bin/layover now",
  "on-click-right": "~/.local/bin/layover menu",
  "on-scroll-up": "~/.local/bin/layover hold +15m",
  "on-scroll-down": "~/.local/bin/layover hold -15m",
  "tooltip": true
}
